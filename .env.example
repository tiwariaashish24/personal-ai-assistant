# Copy to .env and set the values locally. Never commit real OAuth credentials.
JARVIS_GOOGLE_CLIENT_ID=
# Optional for Desktop OAuth clients; set only when Google provides a secret.
JARVIS_GOOGLE_CLIENT_SECRET=

# Optional offline voice paths. Defaults are %APPDATA%\JARVIS\voice\whisper-cli.exe,
# ggml-base.bin, and ggml-small.bin on Windows.
JARVIS_WHISPER_PATH=
JARVIS_WHISPER_MODEL=base
JARVIS_WHISPER_BASE_MODEL=
JARVIS_WHISPER_SMALL_MODEL=
# Whisper CPU thread count (1-16; default 4).
JARVIS_WHISPER_THREADS=4
# Hinglish recognition is biased to Hindi by default; use auto only if needed.
JARVIS_WHISPER_HINGLISH_LANGUAGE=hi
# Whisper's no-speech confidence threshold and bounded per-utterance timeout.
JARVIS_WHISPER_NO_SPEECH_THRESHOLD=0.6
JARVIS_WHISPER_TIMEOUT_SECONDS=90
# Optional exact Windows SAPI voice name; leave empty to select by spoken language.
JARVIS_SAPI_VOICE=
